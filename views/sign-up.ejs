<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Vaultbox</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <section class="bg-slate-900 flex justify-center items-center min-h-screen">
      <div
        class="relative flex flex-col w-full max-w-md items-center justify-center bg-slate-800 border border-slate-700/60 p-8 shadow-xl text-amber-50"
      >
        <a href="/" class="self-start">x</a>

        <h1 class="text-2xl font-bold tracking-tight text-amber-50 mt-2 mb-6">
          Sign Up
        </h1>

        <form
          action=""
          method="POST"
          class="flex flex-col w-full items-center gap-2"
        >
          <label
            for="firstname"
            class="block text-sm font-medium tracking-wide mb-2 text-amber-100"
            >First Name
          </label>
          <input
            type="text"
            name="firstname"
            class="w-full rounded-lg bg-slate-900/80 border border-slate-700 px-3 py-2 text-sm text-amber-50 placeholder-slate-500 focus:outline-none focus:border-amber-200 focus:ring-1 focus:ring-amber-200 transition"
            required
          />

          <label
            for="lastname"
            class="block text-sm font-medium tracking-wide mb-2 text-amber-100"
            >Last Name
          </label>
          <input
            type="text"
            name="lastname"
            class="w-full rounded-lg bg-slate-900/80 border border-slate-700 px-3 py-2 text-sm text-amber-50 placeholder-slate-500 focus:outline-none focus:border-amber-200 focus:ring-1 focus:ring-amber-200 transition"
          />

          <label
            for="username"
            class="block text-sm font-medium tracking-wide mb-2 text-amber-100"
            >Username
          </label>
          <input
            type="text"
            name="username"
            required
            class="w-full rounded-lg bg-slate-900/80 border border-slate-700 px-3 py-2 text-sm text-amber-50 placeholder-slate-500 focus:outline-none focus:border-amber-200 focus:ring-1 focus:ring-amber-200 transition"
          />

          <label
            for="password"
            class="block text-sm font-medium tracking-wide mb-2 text-amber-100"
            >Password</label
          >
          <input
            type="password"
            name="password"
            required
            class="w-full rounded-lg bg-slate-900/80 border border-slate-700 px-3 py-2 text-sm text-amber-50 placeholder-slate-500 focus:outline-none focus:border-amber-200 focus:ring-1 focus:ring-amber-200 transition"
          />

          <label
            for="email"
            class="block text-sm font-medium tracking-wide mb-2 text-amber-100"
            >Email</label
          >
          <input
            type="email"
            name="email"
            required
            class="w-full rounded-lg bg-slate-900/80 border border-slate-700 px-3 py-2 text-sm text-amber-50 placeholder-slate-500 focus:outline-none focus:border-amber-200 focus:ring-1 focus:ring-amber-200 transition"
          />

          <button
            type="submit"
            class="w-full rounded-lg bg-amber-50 px-4 py-2 text-center text-sm font-semibold text-slate-900 transition hover:bg-amber-100 cursor-pointer shadow-sm active:scale-[0.99]"
          >
            Sign-up
          </button>
        </form>
      </div>
    </section>
  </body>
</html>
