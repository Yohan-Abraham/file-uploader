<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Vaultbox</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body class="bg-slate-900 text-slate-100 min-h-screen antialiased">
    <%- include('nav') %>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <% if (locals.currentUser) { %>
        <% currentUser.folders.filter(folder => folder.isRoot).forEach(myDrive => { %>
          
          <!-- Drive Header & Action Bar -->
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pb-6 border-b border-slate-800 mb-8">
            <div>
              <span class="text-xs uppercase tracking-wider text-slate-400 font-semibold">Current Drive</span>
              <h1 class="text-3xl font-bold tracking-tight text-white capitalize"><%= myDrive.name %></h1>
            </div>

            <!-- "New +" Dropdown Menu -->
            <div class="relative">
              <details class="group">
                <summary class="list-none flex items-center gap-2 cursor-pointer select-none bg-blue-600 hover:bg-blue-500 active:bg-blue-700 text-white font-medium px-4 py-2.5 rounded-lg shadow-sm transition-all focus:outline-none focus:ring-2 focus:ring-blue-400">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 transition-transform group-open:rotate-45" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd" />
                  </svg>
                  <span>New</span>
                </summary>

                <ul class="absolute right-0 mt-2 w-44 bg-slate-800 border border-slate-700 rounded-lg shadow-xl py-1.5 z-20 focus:outline-none">
                  <li>
                    <a href="/files" class="flex items-center gap-2 px-4 py-2 text-sm text-slate-200 hover:bg-slate-700 hover:text-white transition-colors">
                      <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/></svg>
                      Add File
                    </a>
                  </li>
                  <li>
                    <a href="/folders" class="flex items-center gap-2 px-4 py-2 text-sm text-slate-200 hover:bg-slate-700 hover:text-white transition-colors">
                      <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 13h6m-3-3v6m-9 1V7a2 2 0 012-2h6l2 2h6a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2z"/></svg>
                      Add Folder
                    </a>
                  </li>
                </ul>
              </details>
            </div>
          </div>

          <!-- Folders Container -->
          <div class="space-y-6">
            <% myDrive.children.forEach(folder => { %>
              <div class="bg-slate-800/80 border border-slate-700/60 rounded-xl p-5 shadow-sm hover:border-slate-600 transition-colors">
                
                <!-- Folder Header: Icon, Name & Folder Actions -->
                <div class="flex flex-wrap items-center justify-between gap-3 pb-4 border-b border-slate-700/50">
                  <div class="flex items-center gap-3">
                    <div class="p-2 bg-amber-500/10 rounded-lg text-amber-400">
                      <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M2 6a2 2 0 012-2h5l2 2h5a2 2 0 012 2v6a2 2 0 01-2 2H4a2 2 0 01-2-2V6z"/>
                      </svg>
                    </div>
                    <div>
                      <h2 class="text-lg font-semibold text-white tracking-wide"><%= folder.name %></h2>
                      <span class="text-xs text-slate-400"><%= folder.files.length %> <%= folder.files.length === 1 ? 'file' : 'files' %></span>
                    </div>
                  </div>

                  <!-- Folder Action Buttons -->
                  <div class="flex items-center gap-2">
                    <form action="/folders/<%= folder.id %>/update" method="get">
                      <button type="submit" class="px-3 py-1.5 text-xs font-medium bg-slate-700 hover:bg-slate-600 text-slate-200 rounded-md transition-colors">
                        Edit
                      </button>
                    </form>

                    <form action="/folders/<%= folder.id %>/delete" method="POST" onsubmit="return confirm('Delete this folder and its contents?');">
                      <button type="submit" class="px-3 py-1.5 text-xs font-medium bg-rose-500/10 hover:bg-rose-500 text-rose-300 hover:text-white rounded-md transition-colors">
                        Delete
                      </button>
                    </form>
                  </div>
                </div>

                <!-- Children / Folder Contents (Files Grid) -->
                <div class="mt-4">
                  <% if (folder.files && folder.files.length > 0) { %>
                    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3">
                      <% folder.files.forEach(file => { %>
                        <div class="flex flex-col justify-between bg-slate-900/60 hover:bg-slate-900 border border-slate-700/40 hover:border-slate-600 rounded-lg p-3.5 transition-all">
                          <!-- File Name & Icon -->
                          <div class="flex items-start gap-2.5 mb-3 min-w-0">
                            <svg class="w-5 h-5 text-blue-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
                            </svg>
                            <span class="text-sm font-medium text-slate-200 truncate" title="<%= file.name %>">
                              <%= file.name %>
                            </span>
                          </div>

                          <!-- File Action Buttons -->
                          <div class="flex items-center justify-end gap-2 pt-2 border-t border-slate-800">
                            <form action="/files/<%= file.id %>/details" method="get">
                              <button type="submit" class="text-xs text-slate-400 hover:text-white transition-colors">
                                Details
                              </button>
                            </form>
                            <span class="text-slate-600">•</span>
                            <form action="/files/<%= file.id %>/delete" method="POST">
                              <button type="submit" class="text-xs text-rose-400 hover:text-rose-300 transition-colors">
                                Delete
                              </button>
                            </form>
                          </div>
                        </div>
                      <% }) %>
                    </div>
                  <% } else { %>
                    <p class="text-sm text-slate-500 italic py-2">No files inside this folder.</p>
                  <% } %>
                </div>

              </div>
            <% }) %>
          </div>

        <% }) %>
      <% } else { %>
        <!-- Guest View -->
        <div class="text-center py-20">
          <p class="text-slate-400 text-lg">Please log in to view your vault.</p>
        </div>
      <% } %>
    </main>
  </body>
</html>