<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Vaultbox</title>
  </head>
  <body>
    <%-include('nav') %>
    <section>
      
      <% if(locals.currentUser) {%>
        <a href="/files">Add File</a>
        <a href="/folders">Add Folder</a>

        <div>
          <% currentUser.folders.filter(folder => folder.isRoot).forEach(myDrive => { %>
            <h1><%= myDrive.name %></h1>

            <% myDrive.files.forEach(file => { %>
              <h2><%= file.name %></h2>
            <% }) %>

            <% myDrive.children.forEach(folder => { %>
              <h2><%= folder.name %></h2>
              <form action="/folders/<%=folder.id%>/update" method="get">
                <button type="submit">Update Folder</button>
              </form>

              <form action="/folders/<%= folder.id %>/delete" method="POST">
                <button type="submit">Delete Folder</button>
              </form>
              <% folder.files.forEach(file => { %>
                <h1><%=file.name  %></h1>
                <form action="/files/<%= file.id %>/details" method="get">
                  <button type="submit">View Details</button>
                </form>

                <form action="/files/<%= file.id %>/delete" method="POST">
                 <button type="submit">Delete File</button>
                </form>
              <% }) %>
            <% }) %>
          <% }) %>
        </div>
    <%}%>
    
    </section>
  </body>
</html>
