<link rel="stylesheet" href="/styles.css" />

<nav class="relative flex items-center justify-between bg-slate-800 p-4 text-amber-50">
  <!-- Brand Logo -->
  <a href="/" class="text-2xl font-bold tracking-tight hover:text-amber-200 transition-colors">
    Vaultbox
  </a>

  <!-- Mobile Hamburger Button (visible on mobile, hidden on md+) -->
  <button 
    id="nav-toggle"
    class="flex h-5 w-6 cursor-pointer flex-col justify-between p-0 md:hidden focus:outline-none" 
    aria-label="Toggle navigation" 
    aria-expanded="false"
  >
    <span class="block h-0.5 w-full rounded bg-amber-50 transition-all"></span>
    <span class="block h-0.5 w-full rounded bg-amber-50 transition-all"></span>
    <span class="block h-0.5 w-full rounded bg-amber-50 transition-all"></span>
  </button>

  <!-- Navigation Menu Links -->
  <!-- Mobile: absolute full-width dropdown | Desktop (md): static horizontal row -->
  <ul 
    id="nav-menu" 
    class="hidden absolute top-full left-0 w-full flex-col gap-4 bg-slate-800 p-6 shadow-lg md:relative md:top-auto md:left-auto md:flex md:w-auto md:flex-row md:items-center md:gap-6 md:p-0 md:shadow-none"
  >
    <% if (locals.currentUser) { %>
      <li>
        <a 
          href="/auth/log-out" 
          class="block text-base font-medium transition-colors hover:text-amber-200 md:inline"
        >
          Log-out
        </a>
      </li>
    <% } else { %>
      <li>
        <a 
          href="/auth/log-in" 
          class="block text-base font-medium transition-colors hover:text-amber-200 md:inline"
        >
          Log-in
        </a>
      </li>
      <li>
        <a 
          href="/auth/sign-up" 
          class="block rounded-lg bg-amber-50 px-4 py-2 text-center text-sm font-semibold text-slate-900 transition hover:bg-amber-100 md:inline-block"
        >
          Sign-Up
        </a>
      </li>
    <% } %>
  </ul>
</nav>

<script>const navToggle = document.getElementById('nav-toggle');
const navMenu = document.getElementById('nav-menu');

navToggle.addEventListener('click', () => {
  // Toggle the 'hidden' class on the menu
  const isHidden = navMenu.classList.toggle('hidden');
  
  // Keep accessibility attributes in sync
  navToggle.setAttribute('aria-expanded', String(!isHidden));
});</script>