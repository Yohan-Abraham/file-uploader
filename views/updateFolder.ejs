<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Vaultbox</title>
  </head>
  <body>
    <%-include('nav') %>
    <section>
      <form action="" method="POST">
        <label for="foldername">Folder Name: </label>
        <input
          type="text"
          name="foldername"
          placeholder="<%=folderInfo.name  %>"
          required
        />
        <button type="submit">Update Folder</button>
      </form>
    </section>
  </body>
</html>
