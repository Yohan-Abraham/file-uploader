<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Vaultbox</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body class="bg-slate-900 flex flex-col text-amber-50 min-h-screen">
    <%-include('nav') %>
    <section class="w-full flex flex-1 items-center justify-center">
      <div
        class="border border-amber-100 px-4 py-4 rounded-2xl flex flex-col justify-center gap-2"
      >
        <h1 class="block text-md font-medium tracking-wide mb-2 text-amber-100">
          File Name: <%=details.name %>
        </h1>
        <p class="block text-md font-medium tracking-wide mb-2 text-amber-100">
          Size: <%=details.size %> bytes
        </p>
        <p class="block text-md font-medium tracking-wide mb-2 text-amber-100">
          Time of Upload: <%=details.uploadTime %>
        </p>
        <p class="block text-md font-medium tracking-wide mb-2 text-amber-100">
          File Type: <%=details.fileType %>
        </p>
        <form action="/files/<%=details.id%>/download" method="POST">
          <button
            type="submit"
            class="w-full rounded-lg bg-amber-50 px-4 py-2 text-center text-sm font-semibold text-slate-900 transition hover:bg-amber-100 cursor-pointer shadow-sm active:scale-[0.99]"
          >
            Download File
          </button>
        </form>
      </div>
    </section>
  </body>
</html>
