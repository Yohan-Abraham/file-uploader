<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Vaultbox - Log In</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body
    class="min-h-screen bg-slate-900 flex items-center justify-center p-4 text-amber-50 font-sans antialiased"
  >
    <div
      class="relative w-full max-w-md rounded-2xl bg-slate-800 border border-slate-700/60 p-8 shadow-xl flex flex-col items-center"
    >
      <a
        href="/"
        class="self-start text-sm font-semibold text-amber-50/60 hover:text-amber-200 transition-colors"
        aria-label="Back to home"
      >
        ✕
      </a>

      <h1 class="text-2xl font-bold tracking-tight text-amber-50 mt-2 mb-6">
        Log In
      </h1>

      <form
        action="/auth/log-in"
        method="POST"
        class="w-full max-w-xs flex flex-col items-center space-y-5"
      >
        <div class="w-full text-center">
          <label
            for="username"
            class="block text-sm font-medium tracking-wide mb-2 text-amber-100"
          >
            Username
          </label>
          <input
            type="text"
            id="username"
            name="username"
            required
            class="w-full rounded-lg bg-slate-900/80 border border-slate-700 px-3 py-2 text-sm text-amber-50 placeholder-slate-500 focus:outline-none focus:border-amber-200 focus:ring-1 focus:ring-amber-200 transition"
          />
        </div>

        <div class="w-full text-center">
          <label
            for="password"
            class="block text-sm font-medium tracking-wide mb-2 text-amber-100"
          >
            Password
          </label>
          <input
            type="password"
            id="password"
            name="password"
            required
            class="w-full rounded-lg bg-slate-900/80 border border-slate-700 px-3 py-2 text-sm text-amber-50 placeholder-slate-500 focus:outline-none focus:border-amber-200 focus:ring-1 focus:ring-amber-200 transition"
          />
        </div>

        <div class="pt-2 w-full flex justify-center">
          <button
            type="submit"
            class="w-full rounded-lg bg-amber-50 px-4 py-2 text-center text-sm font-semibold text-slate-900 transition hover:bg-amber-100 cursor-pointer shadow-sm active:scale-[0.99]"
          >
            Submit
          </button>
        </div>
      </form>
    </div>
  </body>
</html>
